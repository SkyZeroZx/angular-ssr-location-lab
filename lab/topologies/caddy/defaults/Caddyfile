# Caddy 2.11.7 round-robin over two peers, defaults.
#
# Passive health checks are off unless fail_duration is set, and the upstream
# header limit (transport http max_response_header) defaults to 10 MB, so the
# 4,208 B Location is relayed as a 302.
{
	admin off
	auto_https off
}

:8080 {
	log {
		output stdout
		format console
	}

	reverse_proxy ssr-a:4000 ssr-b:4000 {
		lb_policy round_robin
	}
}
